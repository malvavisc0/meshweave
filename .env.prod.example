# Example production environment file.
# Copy to .env.prod, fill in real values, and never commit it.
# Usage:
#   MESHWEAVE_VERSION=latest docker compose -f docker-compose.prod.yaml --env-file .env.prod up -d

# --- Deployment ---
MESHWEAVE_VERSION=latest
SITE_BASE_URL=https://meshweaveai.com
FOOTER_REPO_URL=https://github.com/malvavisc0/meshweave
FOOTER_CONTACT_EMAIL=hello@meshweaveai.com

# --- Session security (REQUIRED: HMAC key for CSRF tokens; generate e.g.
#     with: python -c "import secrets; print(secrets.token_hex(32))" )
WEBAPP_SECRET_KEY=

# --- Postgres ---
POSTGRES_USER=meshweave
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=meshweave

# --- OAuth (Google) ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Optional email domain allowlist (comma-separated); feeds OAUTH_ALLOWED_DOMAINS
# SITE_DOMAIN=yourcompany.com

# --- LLM ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AAX_ENABLED=true

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Telemetry (Rybbit analytics; off unless URL + site id provided) ---
ENABLE_TELEMETRY=false
RYBBIT_SCRIPT_URL=
RYBBIT_SITE_ID=
