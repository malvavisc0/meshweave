# Example production environment file.
# Copy to .env.prod, fill in real values, and never commit it.
# Usage:
#   MESHWEAVE_VERSION=latest docker compose -f docker-compose.prod.yaml --env-file .env.prod up -d

# --- Deployment ---
MESHWEAVE_VERSION=latest
SITE_BASE_URL=https://meshweaveai.com
FOOTER_CONTACT_EMAIL=hello@meshweaveai.com
WEBAPP_PORT=8080

# --- Postgres ---
POSTGRES_USER=meshweave
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=meshweave

# --- OAuth (Google) ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# --- LLM ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AAX_ENABLED=true

# --- Redis (defaults to redis://redis:6379) ---
# REDIS_URL=redis://redis:6379
