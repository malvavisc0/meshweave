# Local development environment file.
# Copy to .env and fill in values. docker-compose.yaml reads it implicitly.

# --- Site ---
SITE_BASE_URL=http://localhost:8080
SITE_NAME=MeshWeave
FOOTER_REPO_URL=https://github.com/malvavisc0/meshweave
FOOTER_CONTACT_EMAIL=hello@meshweaveai.com

# --- OAuth (Google) ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# --- LLM scoring (optional; AAX lens requires it) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AAX_ENABLED=true

# --- Langfuse observability (optional; off unless both keys provided) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: override host (default https://cloud.langfuse.com)
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Telemetry (Rybbit analytics; off unless URL + site id provided) ---
ENABLE_TELEMETRY=false
RYBBIT_SCRIPT_URL=
RYBBIT_SITE_ID=

# --- Session security (HMAC key for CSRF tokens; set a real value) ---
WEBAPP_SECRET_KEY=

# --- Error reporting (Bugsink, Sentry-compatible; off without DSN) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# --- Timezone ---
TZ=Europe/Berlin